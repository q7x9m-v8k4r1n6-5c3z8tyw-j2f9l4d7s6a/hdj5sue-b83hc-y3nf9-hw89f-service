<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OVCMOVE.Application\OVCMOVE.Application.csproj" />
    <ProjectReference Include="..\OVCMOVE.Infrastructure\OVCMOVE.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.0.2" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Keep the plugin optional at compile time, while making local builds include
    it automatically when its project exists. If the plugin folder is removed,
    this target is skipped and the core API remains buildable.
  -->
  <Target Name="CopyOptionalMove2026Plugin" AfterTargets="Build"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\plugin\OVCMOVE2026.Plugin\OVCMOVE2026.Plugin.csproj')">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\..\plugin\OVCMOVE2026.Plugin\OVCMOVE2026.Plugin.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <OptionalMovePluginFiles Include="$(MSBuildThisFileDirectory)..\..\plugin\OVCMOVE2026.Plugin\bin\$(Configuration)\net10.0\*.dll" />
    </ItemGroup>
    <Copy
      SourceFiles="@(OptionalMovePluginFiles)"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
